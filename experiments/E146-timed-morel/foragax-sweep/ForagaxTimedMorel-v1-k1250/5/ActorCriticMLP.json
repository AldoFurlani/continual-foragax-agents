{
    "agent": "ActorCriticMLP",
    "problem": "Foragax",
    "total_steps": 1000000,
    "metaParameters": {
        "environment": {
            "env_id": "ForagaxTimedMorel-v1",
            "aperture_size": 5,
            "observation_type": "color",
            "fog": true,
            "band_move_every": 1250
        },
        "experiment": {
            "seed_offset": 1000000
        },
        "gamma": 0.99,
        "gae_lambda": 0.95,
        "rollout_steps": 2048,
        "epochs": 4,
        "num_mini_batch": 32,
        "clip_eps": 0.2,
        "gradient_clipping": true,
        "max_grad_norm": 0.5,
        "vf_coef": 0.5,
        "entropy_coef": [
            0.01,
            0.1,
            1.0
        ],
        "optimizer_actor": {
            "name": "Adam",
            "alpha": [
                0.001,
                0.0003,
                0.0001
            ],
            "beta1": 0.9,
            "beta2": 0.999,
            "eps": 1e-05
        },
        "optimizer_critic": {
            "name": "Adam",
            "lr_scale": [
                1.0,
                10.0,
                0.1
            ],
            "beta1": 0.9,
            "beta2": 0.999,
            "eps": 1e-05
        },
        "representation": {
            "hidden": 64,
            "d_hidden": 512,
            "use_layernorm": true
        }
    }
}
